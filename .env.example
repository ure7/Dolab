# Copy this file to .env.local and fill in the values.
# Find them in Supabase: Project Settings → API Keys / Data API.

# Your project URL, e.g. https://abcdefghijklm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# The *publishable* key (starts with sb_publishable_...). The legacy "anon" key also works.
# It is safe to expose in the browser because Row Level Security protects the data.
# NEVER put the secret / service_role key here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
